# Copy to .env for local testing, or set these as environment variables on
# your hosting platform (Railway/Render/Fly.io). Never commit the real .env.

# Your Telegram bot token (from @BotFather). If you're migrating the existing
# widget's bot rather than making a new one, this is the same token that is
# currently hardcoded in ../telegramBotService.js — consider rotating it via
# @BotFather once the cloud bot is live, since it's been sitting in the repo
# in plaintext.
TELEGRAM_BOT_TOKEN=

# The only Telegram chat ID allowed to use this bot.
TELEGRAM_CHAT_ID=

# Shared secret the PC widget must send with every push. Generate a long
# random string — this is the only thing standing between the internet and
# your quota data endpoint.
PUSH_SECRET=

# Port the platform expects the server to listen on (Railway/Render set this
# automatically via $PORT; only needed for local testing).
PORT=3000

# Remaining-% threshold below which a code-AI provider triggers a one-time
# low-quota alert (resets once it recovers back above this threshold).
LOW_QUOTA_THRESHOLD=20
